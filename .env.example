# ---- Servidor ----
PORT=3000
# Clave para firmar los tokens JWT. Cambiala por una cadena larga y aleatoria.
JWT_SECRET=cambia-esto-por-una-clave-larga-y-secreta

# ---- MySQL (XAMPP por defecto) ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=acordes

# ---- Compartir ----
# URL pública de la app (para los links de compartir listas por WhatsApp).
# En local dejalo vacío. En el deploy: PUBLIC_URL=https://tu-app.up.railway.app
PUBLIC_URL=

# ---- Admin automático (opcional, útil para el primer deploy en la nube) ----
# Si los ponés y todavía no hay ningún admin, el server crea uno al arrancar.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_EMAIL=
