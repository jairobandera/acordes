# ---- Servidor ----
PORT=3000
# Clave para firmar los tokens JWT. Cambiala por una cadena larga y aleatoria.
JWT_SECRET=cambia-esto-por-una-clave-larga-y-secreta

# ---- Base de datos: PostgreSQL (Supabase) ----
# Pegá el connection string de Supabase (Project Settings -> Database -> Connection string).
# Usá el "pooler" (Supavisor) para que funcione en Render. Ej:
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Schema donde viven las tablas de esta app (aislado de otras apps del proyecto).
DB_SCHEMA=acordes

# SSL (Supabase lo exige). Dejalo en true; solo poné false para un Postgres local sin SSL.
DB_SSL=true

# ---- Admin automático (opcional, para el primer deploy) ----
# Si los ponés y todavía no hay ningún admin, el server crea uno al arrancar.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ---- Compartir ----
# URL pública de la app (para los links de compartir listas por WhatsApp).
# En local dejalo vacío. En el deploy: PUBLIC_URL=https://tu-app.onrender.com
PUBLIC_URL=
