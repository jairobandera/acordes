# ---- Servidor ----
PORT=3000
# Clave para firmar los tokens JWT. Cambiala por una cadena larga y aleatoria.
JWT_SECRET=cambia-esto-por-una-clave-larga-y-secreta

# ---- Base de datos: PostgreSQL ----
# Connection string de PostgreSQL. En el VPS (Coolify) es el host interno del contenedor. Ej:
# DATABASE_URL=postgresql://usuario:clave@host:5432/apps
DATABASE_URL=

# Schema donde viven las tablas de esta app (aislado de otras apps del proyecto).
DB_SCHEMA=acordes

# SSL: true para una base remota que lo exija; false para una base en el mismo servidor o local.
DB_SSL=true

# ---- Admin automático (opcional, para el primer deploy) ----
# Si los ponés y todavía no hay ningún admin, el server crea uno al arrancar.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ---- Compartir ----
# URL pública de la app (para los links de compartir listas por WhatsApp).
# En local dejalo vacío. En el deploy: PUBLIC_URL=https://acordes.pckairos.cloud
PUBLIC_URL=
